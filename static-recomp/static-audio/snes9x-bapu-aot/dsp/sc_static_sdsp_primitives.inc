	     0,
	     0
};

inline void SCStaticSPC_DSP::sc_init_counter()
{
	m.counter = 0;
}

inline void SCStaticSPC_DSP::sc_run_counters()
{
	if ( --m.counter < 0 )
		m.counter = sc_simple_counter_range - 1;
}

inline unsigned SCStaticSPC_DSP::sc_read_counter( int rate )
{
	return ((unsigned) m.counter + sc_counter_offsets [rate]) % sc_counter_rates [rate];
}


//// Envelope

inline void SCStaticSPC_DSP::sc_run_envelope( voice_t* const v )
{
	int env = v->env;
	if ( v->env_mode == env_release ) // 60%
	{
		if ( (env -= 0x8) < 0 )
			env = 0;
		v->env = env;
	}
	else
	{
		int rate;
		int env_data = VREG(v->regs,adsr1);
		if ( m.t_adsr0 & 0x80 ) // 99% ADSR
		{
			if ( v->env_mode >= env_decay ) // 99%
			{
				env--;
				env -= env >> 8;
				rate = env_data & 0x1F;
				if ( v->env_mode == env_decay ) // 1%
					rate = (m.t_adsr0 >> 3 & 0x0E) + 0x10;
			}
			else // env_attack
			{
				rate = (m.t_adsr0 & 0x0F) * 2 + 1;
				env += rate < 31 ? 0x20 : 0x400;
			}
		}
		else // GAIN
		{
			int mode;
			env_data = VREG(v->regs,gain);
			mode = env_data >> 5;
			if ( mode < 4 ) // direct
			{
				env = env_data * 0x10;
				rate = 31;
			}
			else
			{
				rate = env_data & 0x1F;
				if ( mode == 4 ) // 4: linear decrease
				{
					env -= 0x20;
				}
				else if ( mode < 6 ) // 5: exponential decrease
				{
					env--;
					env -= env >> 8;
				}
				else // 6,7: linear increase
				{
					env += 0x20;
					if ( mode > 6 && (unsigned) v->hidden_env >= 0x600 )
						env += 0x8 - 0x20; // 7: two-slope linear increase
				}
			}
		}

		// Sustain level
		if ( (env >> 8) == (env_data >> 5) && v->env_mode == env_decay )
			v->env_mode = env_sustain;

		v->hidden_env = env;

		// unsigned cast because linear decrease going negative also triggers this
		if ( (unsigned) env > 0x7FF )
		{
			env = (env < 0 ? 0 : 0x7FF);
			if ( v->env_mode == env_attack )
				v->env_mode = env_decay;
		}

		if ( !sc_read_counter( rate ) )
			v->env = env; // nothing else is controlled by the counter
	}
}


//// BRR Decoding

inline void SCStaticSPC_DSP::sc_decode_brr( voice_t* v )
{
	// Arrange the four input nybbles in 0xABCD order for easy decoding
	int nybbles = m.t_brr_byte * 0x100 + m.ram [(v->brr_addr + v->brr_offset + 1) & 0xFFFF];

	int const header = m.t_brr_header;

	// Write to next four samples in circular buffer
	int* pos = &v->buf [v->buf_pos];
	int* end;
	if ( (v->buf_pos += 4) >= brr_buf_size )
		v->buf_pos = 0;

	// Decode four samples
	for ( end = pos + 4; pos < end; pos++, nybbles <<= 4 )
	{
		// Extract nybble and sign-extend
		int s = (int16_t) nybbles >> 12;

		// Shift sample based on header
		int const shift = header >> 4;
		if (shift <= 12)
			s = (s << shift) >> 1;
		else
			s &= ~0x7ff;

		// Apply IIR filter (8 is the most commonly used)
		int const filter = header & 0x0C;
		int const p1 = pos [brr_buf_size - 1];
		int const p2 = pos [brr_buf_size - 2] >> 1;
		if ( filter >= 8 )
		{
			s += p1;
			s -= p2;
			if ( filter == 8 ) // s += p1 * 0.953125 - p2 * 0.46875
			{
				s += p2 >> 4;
				s += (p1 * -3) >> 6;
			}
			else // s += p1 * 0.8984375 - p2 * 0.40625
			{
				s += (p1 * -13) >> 7;
				s += (p2 * 3) >> 4;
			}
		}
		else if ( filter ) // s += p1 * 0.46875
		{
			s += p1 >> 1;
			s += (-p1) >> 5;
		}

		// Adjust and write sample
		CLAMP16( s );
		s = (int16_t) (s * 2);
		pos [brr_buf_size] = pos [0] = s; // second copy simplifies wrap-around
	}
}


//// Misc

#define SC_MISC_CLOCK( n ) inline void SCStaticSPC_DSP::sc_misc_##n()

SC_MISC_CLOCK( 27 )
{
	m.t_pmon = REG(pmon) & 0xFE; // voice 0 doesn't support PMON
}
SC_MISC_CLOCK( 28 )
{
	m.t_non = REG(non);
	m.t_eon = REG(eon);
	m.t_dir = REG(dir);
}
SC_MISC_CLOCK( 29 )
{
	if ( (m.every_other_sample ^= 1) != 0 )
		m.new_kon &= ~m.kon; // clears KON 63 clocks after it was last read
}
SC_MISC_CLOCK( 30 )
{
	if ( m.every_other_sample )
	{
		m.kon    = m.new_kon;
		m.t_koff = REG(koff) | m.mute_mask;
	}

	sc_run_counters();

	// Noise
	if ( !sc_read_counter( REG(flg) & 0x1F ) )
	{
		int feedback = (m.noise << 13) ^ (m.noise << 14);
		m.noise = (feedback & 0x4000) ^ (m.noise >> 1);
	}
}


//// Voices

#define SC_VOICE_CLOCK( n ) void SCStaticSPC_DSP::sc_voice_##n( voice_t* const v )

inline SC_VOICE_CLOCK( V1 )
{
	m.t_dir_addr = (m.t_dir * 0x100 + m.t_srcn * 4) & 0xffff;
	m.t_srcn = VREG(v->regs,srcn);
}
inline SC_VOICE_CLOCK( V2 )
{
	// Read sample pointer (ignored if not needed)
	uint8_t const* entry = &m.ram [m.t_dir_addr];
	if ( !v->kon_delay )
		entry += 2;
	m.t_brr_next_addr = GET_LE16A( entry );

	m.t_adsr0 = VREG(v->regs,adsr0);

	// Read pitch, spread over two clocks
	m.t_pitch = VREG(v->regs,pitchl);
}
inline SC_VOICE_CLOCK( V3a )
{
	m.t_pitch += (VREG(v->regs,pitchh) & 0x3F) << 8;
}
inline SC_VOICE_CLOCK( V3b )
{
	if (!::sc_static_sdsp_brr_step(v->brr_addr, m.ram)) return;
	// Read BRR header and byte
	m.t_brr_byte   = m.ram [(v->brr_addr + v->brr_offset) & 0xFFFF];
	m.t_brr_header = m.ram [v->brr_addr]; // brr_addr doesn't need masking
}

inline SC_VOICE_CLOCK( V3c )
{
	// Pitch modulation using previous voice's output
	if ( m.t_pmon & v->vbit )
		m.t_pitch += ((m.t_output >> 5) * m.t_pitch) >> 10;

	if ( v->kon_delay )
	{
		// Get ready to start BRR decoding on next sample
		if ( v->kon_delay == 5 )
		{
			v->brr_addr    = m.t_brr_next_addr;
			v->brr_offset  = 1;
			v->buf_pos     = 0;
			m.t_brr_header = 0; // header is ignored on this sample
			m.kon_check    = true;

			if (take_spc_snapshot)
			{
				take_spc_snapshot = 0;
				if (spc_snapshot_callback)
					spc_snapshot_callback();
			}
		}

		// Envelope is never run during KON
		v->env        = 0;
		v->hidden_env = 0;

		// Disable BRR decoding until last three samples
		v->interp_pos = 0;
		if ( --v->kon_delay & 3 )
			v->interp_pos = 0x4000;

		// Pitch is never added during KON
		m.t_pitch = 0;
	}

	// Gaussian interpolation
	{
		int output = sc_interpolate( v );

		// Noise
		if ( m.t_non & v->vbit )
			output = (int16_t) (m.noise * 2);

		// Apply envelope
		m.t_output = (output * v->env) >> 11 & ~1;
		v->t_envx_out = (uint8_t) (v->env >> 4);
	}

	// Immediate silence due to end of sample or soft reset
	if ( REG(flg) & 0x80 || (m.t_brr_header & 3) == 1 )
	{
		v->env_mode = env_release;
		v->env      = 0;
	}

	if ( m.every_other_sample )
	{
		// KOFF
		if ( m.t_koff & v->vbit )
			v->env_mode = env_release;

		// KON
		if ( m.kon & v->vbit )
		{
			v->kon_delay = 5;
			v->env_mode  = env_attack;
		}
	}

	// Run envelope for next sample
	if ( !v->kon_delay )
		sc_run_envelope( v );
}

inline void SCStaticSPC_DSP::sc_voice_output( voice_t const* v, int ch )
{
	// Apply left/right volume
	int amp = (m.t_output * (int8_t) VREG(v->regs,voll + ch)) >> 7;
	amp *= ((stereo_switch & (1 << (v->voice_number + ch * voice_count))) ? 1 : 0);

	// Add to output total
	m.t_main_out [ch] += amp;
	CLAMP16( m.t_main_out [ch] );

	// Optionally add to echo total
	if ( m.t_eon & v->vbit )
	{
		m.t_echo_out [ch] += amp;
		CLAMP16( m.t_echo_out [ch] );
	}
}

inline SC_VOICE_CLOCK( V4 )
{
	// Decode BRR
	m.t_looped = 0;
	if ( v->interp_pos >= 0x4000 )
	{
		sc_decode_brr( v );

		if ( (v->brr_offset += 2) >= brr_block_size )
		{
			// Start decoding next BRR block
			assert( v->brr_offset == brr_block_size );
			v->brr_addr = (v->brr_addr + brr_block_size) & 0xFFFF;
			if ( m.t_brr_header & 1 )
			{
				v->brr_addr = m.t_brr_next_addr;
				m.t_looped = v->vbit;
			}
			v->brr_offset = 1;
		}
	}

	// Apply pitch
	v->interp_pos = (v->interp_pos & 0x3FFF) + m.t_pitch;

	// Keep from getting too far ahead (when using pitch modulation)
	if ( v->interp_pos > 0x7FFF )
		v->interp_pos = 0x7FFF;

	// Output left
	sc_voice_output( v, 0 );
}
inline SC_VOICE_CLOCK( V5 )
{
	// Output right
	sc_voice_output( v, 1 );

	// ENDX, OUTX, and ENVX won't update if you wrote to them 1-2 clocks earlier
	int endx_buf = REG(endx) | m.t_looped;

	// Clear bit in ENDX if KON just began
	if ( v->kon_delay == 5 )
		endx_buf &= ~v->vbit;
	m.endx_buf = (uint8_t) endx_buf;
}
inline SC_VOICE_CLOCK( V6 )
{
	(void) v; // avoid compiler warning about unused v
	m.outx_buf = (uint8_t) (m.t_output >> 8);
}
inline SC_VOICE_CLOCK( V7 )
{
	// Update ENDX
	REG(endx) = m.endx_buf;
	XREG(endx) = m.endx_buf;

	m.envx_buf = v->t_envx_out;
}
inline SC_VOICE_CLOCK( V8 )
{
	// Update OUTX
	VREG(v->regs,outx) = m.outx_buf;
	XVREG(v->regs,outx) = m.outx_buf;
}
inline SC_VOICE_CLOCK( V9 )
{
	// Update ENVX
	VREG(v->regs,envx) = m.envx_buf;
	XVREG(v->regs,envx) = m.envx_buf;
}

// Most voices do all these in one clock, so make a handy composite
inline SC_VOICE_CLOCK( V3 )
{
	sc_voice_V3a( v );
	sc_voice_V3b( v );
	sc_voice_V3c( v );
}

// Common combinations of voice steps on different voices. This greatly reduces
// code size and allows everything to be inlined in these functions.
SC_VOICE_CLOCK(V7_V4_V1) { sc_voice_V7(v); sc_voice_V1(v+3); sc_voice_V4(v+1); }
SC_VOICE_CLOCK(V8_V5_V2) { sc_voice_V8(v); sc_voice_V5(v+1); sc_voice_V2(v+2); }
SC_VOICE_CLOCK(V9_V6_V3) { sc_voice_V9(v); sc_voice_V6(v+1); sc_voice_V3(v+2); }


//// Echo

// Current echo buffer pointer for left/right channel
#define SC_ECHO_PTR( ch )      ((SCStaticSettings.SeparateEchoBuffer) ? (&m.separate_echo_buffer [m.t_echo_ptr + ch * 2]) : (&m.ram [m.t_echo_ptr + ch * 2]))

// Sample in echo history buffer, where 0 is the oldest
#define SC_ECHO_FIR( i )       (m.echo_hist_pos [i])

// Calculate FIR point for left/right channel
#define SC_CALC_FIR( i, ch )   ((SC_ECHO_FIR( i + 1 ) [ch] * (int8_t) REG(fir + i * 0x10)) >> 6)

#define SC_ECHO_CLOCK( n ) inline void SCStaticSPC_DSP::sc_echo_##n()

inline void SCStaticSPC_DSP::sc_echo_read( int ch )
{
	int s = GET_LE16SA( SC_ECHO_PTR( ch ) );
	// second copy simplifies wrap-around handling
	SC_ECHO_FIR( 0 ) [ch] = SC_ECHO_FIR( 8 ) [ch] = s >> 1;
}

SC_ECHO_CLOCK( 22 )
{
	// History
	if ( ++m.echo_hist_pos >= &m.echo_hist [echo_hist_size] )
		m.echo_hist_pos = m.echo_hist;

	m.t_echo_ptr = (m.t_esa * 0x100 + m.echo_offset) & 0xFFFF;
	sc_echo_read( 0 );

	// FIR (using l and r temporaries below helps compiler optimize)
	int l = SC_CALC_FIR( 0, 0 );
	int r = SC_CALC_FIR( 0, 1 );

	m.t_echo_in [0] = l;
	m.t_echo_in [1] = r;
}
SC_ECHO_CLOCK( 23 )
{
	int l = SC_CALC_FIR( 1, 0 ) + SC_CALC_FIR( 2, 0 );
	int r = SC_CALC_FIR( 1, 1 ) + SC_CALC_FIR( 2, 1 );

	m.t_echo_in [0] += l;
	m.t_echo_in [1] += r;

	sc_echo_read( 1 );
}
SC_ECHO_CLOCK( 24 )
{
	int l = SC_CALC_FIR( 3, 0 ) + SC_CALC_FIR( 4, 0 ) + SC_CALC_FIR( 5, 0 );
	int r = SC_CALC_FIR( 3, 1 ) + SC_CALC_FIR( 4, 1 ) + SC_CALC_FIR( 5, 1 );

	m.t_echo_in [0] += l;
	m.t_echo_in [1] += r;
}
SC_ECHO_CLOCK( 25 )
{
	int l = m.t_echo_in [0] + SC_CALC_FIR( 6, 0 );
	int r = m.t_echo_in [1] + SC_CALC_FIR( 6, 1 );

	l = (int16_t) l;
	r = (int16_t) r;

	l += (int16_t) SC_CALC_FIR( 7, 0 );
	r += (int16_t) SC_CALC_FIR( 7, 1 );

	CLAMP16( l );
	CLAMP16( r );

	m.t_echo_in [0] = l & ~1;
	m.t_echo_in [1] = r & ~1;
}
inline int SCStaticSPC_DSP::sc_echo_output( int ch )
{
	int out = (int16_t) ((m.t_main_out [ch] * (int8_t) REG(mvoll + ch * 0x10)) >> 7) +
			(int16_t) ((m.t_echo_in [ch] * (int8_t) REG(evoll + ch * 0x10)) >> 7);
	CLAMP16( out );
	return out;
}
SC_ECHO_CLOCK( 26 )
{
	// Left output volumes
	// (save sample for next clock so we can output both together)
	m.t_main_out [0] = sc_echo_output( 0 );

	// Echo feedback
	int l = m.t_echo_out [0] + (int16_t) ((m.t_echo_in [0] * (int8_t) REG(efb)) >> 7);
	int r = m.t_echo_out [1] + (int16_t) ((m.t_echo_in [1] * (int8_t) REG(efb)) >> 7);

	CLAMP16( l );
	CLAMP16( r );

	m.t_echo_out [0] = l & ~1;
	m.t_echo_out [1] = r & ~1;
}
SC_ECHO_CLOCK( 27 )
{
	// Output
	int l = m.t_main_out [0];
	int r = sc_echo_output( 1 );
	m.t_main_out [0] = 0;
	m.t_main_out [1] = 0;

	// TODO: global muting isn't this simple (turns DAC on and off
	// or something, causing small ~37-sample pulse when first muted)
	if ( REG(flg) & 0x40 )
	{
		l = 0;
		r = 0;
	}

	// Output sample to DAC
		sample_t* out = m.out;
		WRITE_SAMPLES( l, r, out );
		m.out = out;
}
SC_ECHO_CLOCK( 28 )
{
	m.t_echo_enabled = REG(flg);
}
inline void SCStaticSPC_DSP::sc_echo_write( int ch )
{
	if ( !(m.t_echo_enabled & 0x20) )
		SET_LE16A( SC_ECHO_PTR( ch ), m.t_echo_out [ch] );

	m.t_echo_out [ch] = 0;
}
SC_ECHO_CLOCK( 29 )
{
	m.t_esa = REG(esa);

	if ( !m.echo_offset )
		m.echo_length = (REG(edl) & 0x0F) * 0x800;

	m.echo_offset += 4;
	if ( m.echo_offset >= m.echo_length )
		m.echo_offset = 0;

	// Write left echo
	sc_echo_write( 0 );

	m.t_echo_enabled = REG(flg);
}
SC_ECHO_CLOCK( 30 )
{
	// Write right echo
	sc_echo_write( 1 );
}





