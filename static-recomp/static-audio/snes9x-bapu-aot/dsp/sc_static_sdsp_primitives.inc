// Generated static-only sc_* method namespace for SimCity Full Static audio.

inline int SCStaticSPC_DSP::sc_interpolate( voice_t const* v )
{
    if (SCStaticSettings.InterpolationMethod != 2)
    {
        ::sc_static_sdsp_primitive_step(254u);
        return 0;
    }
    int const* in = &v->buf [(v->interp_pos >> 12) + v->buf_pos];
    int offset = v->interp_pos >> 4 & 0xFF;
    short const* fwd = gauss + 255 - offset;
    short const* rev = gauss + offset;
    int out  = (fwd [0] * in [0]) >> 11;
    out += (fwd [256] * in [1]) >> 11;
    out += (rev [256] * in [2]) >> 11;
    out = (int16_t) out;
    out += (rev [0] * in [3]) >> 11;
    CLAMP16( out );
    return out & ~1;
}


